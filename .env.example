# Neon Postgres — احصل عليه من https://console.neon.tech
DATABASE_URL=postgres://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# مفتاح سري للتوقيع (استبدله بقيمة عشوائية طويلة — 32 حرف على الأقل)
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# اختياري: للتعامل مع النطاق في الإنتاج
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
