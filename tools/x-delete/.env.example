# ============================================================
# بيانات اعتماد X API — احصل عليها من:
# https://developer.x.com/en/portal/dashboard
# ============================================================
# أنشئ تطبيق (App) داخل Project، ثم فعّل "User authentication settings":
#   - Type of App: Web App / Automated App or Bot
#   - App permissions: Read and write
# ثم من "Keys and tokens" أنشئ:
#   1) API Key + API Key Secret         (مفاتيح التطبيق)
#   2) Access Token + Access Token Secret (مفاتيحك الشخصية — زر Generate)

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ============================================================
# إعدادات اختيارية
# ============================================================
# أقصى عدد حذف في كل جلسة (مفيد لتفادي rate limit الكامل)
MAX_DELETE_PER_RUN=1000

# مللي ثانية بين كل عملية حذف (الافتراضي 1200ms = ~50 طلب/دقيقة)
DELAY_MS=1200

# احذف فقط التغريدات الأقدم من هذا التاريخ (YYYY-MM-DD) — اتركه فارغاً للحذف الكلي
OLDER_THAN=

# احذف فقط التغريدات الأحدث من هذا التاريخ (YYYY-MM-DD)
NEWER_THAN=

# استثنِ التغريدات المثبّتة؟ (true/false)
KEEP_PINNED=true

# استثنِ التغريدات التي تلقّت أكثر من X إعجاب؟ (0 = لا استثناء)
KEEP_IF_LIKES_ABOVE=0
